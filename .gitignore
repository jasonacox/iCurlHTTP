# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch
!iCurlHTTP/iCurlHTTP-Prefix.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Local
.DS_Store

# Xcode signing / iOS provisioning material - never commit these
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.p8
ExportOptions.plist
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# Xcode user-specific / local state
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Local-only asset archive (kept on disk, not tracked in git)
/Screenshots and Images/

# Prebuilt curl/openssl/nghttp2 libraries (huge binaries) - build via
# https://github.com/jasonacox/Build-OpenSSL-cURL and keep them local only
/lib/*.xcframework/*
!/lib/*.xcframework/Info.plist

